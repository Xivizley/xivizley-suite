# ============================================================================
# XIVIZLEY Suite — Self-Hosted Yapılandırma Dosyası (.env)
# Kendi sunucunuzda ve kendi alan adınızda (domain) çalıştırmak için düzenleyin.
# ============================================================================

# 1. Alan Adı (Domain) ve SSL (Let's Encrypt) Ayarları
# Kendi alan adınızı yazın (örn: cloud.sirketim.com veya panel.benimdomainim.com).
# Eğer sadece IP üzerinden HTTP ile kullanacaksanız ":80" yazabilirsiniz.
DOMAIN=cloud.example.com
ACME_EMAIL=admin@example.com

# Alt alan adları arası çerez paylaşımı (Opsiyonel, tek domain için boş bırakın)
COOKIE_DOMAIN=

# 2. Veritabanı ve Kriptografik Anahtarlar (`./install.sh` otomatik üretir)
POSTGRES_PASSWORD=change_me_strong_db_password
COOKIE_SECRET=change_me_random_32_character_cookie_secret
VAULT_MASTER_KEY=change_me_zero_knowledge_vault_master_key_32b

# 3. RS256 JWT Anahtar Çifti (`./install.sh` tarafından otomatik doldurulur)
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# 4. Bildirimler (Opsiyonel — Shield & Pulse Telegram Uyarıları)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
