{
	# Global Caddy ayarları (Kullanıcı .env içinde ACME_EMAIL belirleyebilir)
	email {$ACME_EMAIL:admin@xivizley.com.tr}
}

(common_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 3
		}
		format json
	}
}

(no_search_engines) {
	header {
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
		-Server
	}
	@block_robots path /robots.txt
	header @block_robots Content-Type "text/plain; charset=utf-8"
	respond @block_robots "User-agent: *\nAllow: /\n" 200

	@search_bots {
		header_regexp User-Agent "(?i)(googlebot|bingbot|yandex|duckduckbot|baiduspider|slurp)"
		not path /robots.txt
	}
	header @search_bots X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
	respond @search_bots "410 Gone - This resource is permanently removed from search indices." 410
}

# ─── Unified Hub (Kullanıcının Kendi Domaini veya Varsayılan) ──────────────
{$DOMAIN:suite.xivizley.com.tr} {
	import common_log
	import no_search_engines
	reverse_proxy hub:3000 {
		flush_interval -1
	}
}

# ─── Alt Alan Adları (Geriye Dönük Uyumluluk & Yönlendirme) ────
drive.xivizley.com.tr {
	import common_log
	import no_search_engines
	@root path /
	redir @root https://suite.xivizley.com.tr/files permanent
	reverse_proxy hub:3000
}

