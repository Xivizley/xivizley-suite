# ─── XIVIZLEY Suite — Ortam Değişkenleri Şablonu ──────────
# Bu dosyayı kopyalayın: cp .env.example .env
# .env dosyasını asla Git'e commit etmeyin.

# ─── PostgreSQL 16 ────────────────────────────────────────
POSTGRES_PASSWORD=degistir_bunu

# Servisler bu URL'yi kullanır:
DATABASE_URL=postgresql://xivizley:degistir_bunu@postgres:5432/xivizley_suite

# ─── SSO (XIVIZLEY ID) ────────────────────────────────────
JWT_SECRET=en_az_64_karakter_uzun_rastgele_bir_deger
JWT_REFRESH_SECRET=baska_bir_64_karakter_uzun_rastgele_deger
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Caddy ────────────────────────────────────────────────
# Otomatik HTTPS için: admin@xivizley.com.tr
CADDY_ADMIN_EMAIL=admin@xivizley.com.tr

# ─── Resource Governor ────────────────────────────────────
TOTAL_RAM_MB=8192
TOTAL_CPU_CORES=4
BRAIN_SUSPEND_THRESHOLD=0.80
VAULT_HALT_THRESHOLD=0.90
POLL_INTERVAL_MS=2000
