{
  "name": "@xivizley/aurora-ui",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./src/styles/aurora-theme.css"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
